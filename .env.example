# NoteShare Environment Configuration

# Supabase Cloud Database & Storage (Required for multi-user sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (Optional: for AI academic note verification)
VITE_GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key

# Server Port (Used by Render / local production server)
PORT=5000
